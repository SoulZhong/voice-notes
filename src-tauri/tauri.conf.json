{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voice-notes",
  "version": "0.5.0",
  "identifier": "com.teemo.voice-notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/fix-bundle-dylibs.mjs",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Notes",
        "width": 800,
        "height": 600,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/notes/**", "$APPDATA/voiceprints/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NTdBN0NGMkNEMDc2NzgKUldSNGR0QXN6NmRYZGtZNGFTdFVQOEkwM0lZZmJKODBGRUlIbUV0ak9SdVpLdmJ2OFRNNG95eGsK",
      "endpoints": [
        "https://github.com/SoulZhong/voice-notes/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "voice-notes Dev",
      "entitlements": "./Entitlements.plist",
      "frameworks": [
        "target/bundle-libs/libabsl_base.dylib",
        "target/bundle-libs/libabsl_raw_logging_internal.dylib",
        "target/bundle-libs/libabsl_log_severity.dylib",
        "target/bundle-libs/libabsl_spinlock_wait.dylib",
        "target/bundle-libs/libabsl_strings.dylib",
        "target/bundle-libs/libabsl_strings_internal.dylib",
        "target/bundle-libs/libabsl_int128.dylib",
        "target/bundle-libs/libabsl_string_view.dylib",
        "target/bundle-libs/libabsl_throw_delegate.dylib"
      ]
    }
  }
}
